<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- AK8 Event Mode: keep Bluetooth scanning alive while the phone is locked at an event.
       Android 14+ requires the service type and its matching permission (MASTER_SPEC 7.2). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <service
      android:name="expo.modules.eventmode.EventModeService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
