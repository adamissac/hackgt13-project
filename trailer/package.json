{
  "name": "constellation-trailer",
  "version": "1.0.0",
  "private": true,
  "description": "Launch trailer for Constellation (HackGT 13), built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:main": "remotion render src/index.ts Trailer16x9 out/constellation-trailer-16x9.mp4",
    "render:vertical": "remotion render src/index.ts Trailer9x16 out/constellation-trailer-9x16.mp4",
    "render:sting": "remotion render src/index.ts Sting out/constellation-sting.mp4",
    "render:all": "npm run render:main && npm run render:vertical && npm run render:sting",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "python3 scripts/prepare.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@remotion/cli": "^4.0.529",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}