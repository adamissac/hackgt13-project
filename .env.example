# Copy this file to .env and fill in values. NEVER commit .env.
# Share real values in the team chat only.

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=        # ML service only, never in the mobile app
SUPABASE_JWT_SECRET=         # ML service only. Legacy HS256 JWT secret; leave empty if the project uses JWKS signing keys
DATABASE_URL=                # ML service only. Postgres connection string (Supabase > Connect > session pooler, port 5432)

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=          # configured inside Supabase Auth, listed here for reference
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

ML_API_URL=http://localhost:8000
TOKEN_ENCRYPTION_KEY=        # any long random string
QR_SIGNING_KEY=              # ML service only. Any long random string; signs verification QR payloads
CORS_ORIGINS=                # ML service. Comma-separated dashboard origins (defaults to localhost)
DASHBOARD_REQUIRE_AUTH=      # ML service. 1 = organizer map needs an org member token (default 0 for the demo)
QUIET_HOURS=                 # ML service. e.g. 23-8: no Open to Meet suggestions in those hours (server local time)
MATCH_MODEL=                 # ML service. v1 (default) or lr = serve data/ranker_lr.pkl from scripts/train_ranker.py
