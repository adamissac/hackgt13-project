# Copy this file to .env and fill in values. NEVER commit .env.
# Share real values in the team chat only.
#
# Comments live on their own line, never after `KEY=`. python-dotenv returns a trailing
# comment as the VALUE when the key is left empty, so `SUPABASE_JWT_SECRET=   # leave empty`
# arrives as the comment text rather than "" and the code's "empty means unset" defaults
# never fire. (A key that HAS a value strips its trailing comment correctly; only empty
# ones break.) Keep this layout when adding variables.

ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ML service only, never in the mobile app
SUPABASE_SERVICE_KEY=
# ML service only. Legacy HS256 JWT secret; leave empty if the project uses JWKS signing keys
SUPABASE_JWT_SECRET=
# ML service only. Postgres connection string (Supabase > Connect > session pooler, port 5432)
DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# configured inside Supabase Auth, listed here for reference
LINKEDIN_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

ML_API_URL=http://localhost:8000
# dashboard https page that redirects to formalconnect://invite/<token>
INVITE_BASE_URL=
# any long random string
TOKEN_ENCRYPTION_KEY=
# ML service only. Any long random string; signs verification QR payloads
QR_SIGNING_KEY=
# ML service. Comma-separated dashboard origins (defaults to localhost)
CORS_ORIGINS=
# ML service. 1 = organizer map needs an org member token (default 0 for the demo)
DASHBOARD_REQUIRE_AUTH=
# ML service. e.g. 23-8: no Open to Meet suggestions in those hours (server local time)
QUIET_HOURS=
# ML service. v1 (default) or lr = serve data/ranker_lr.pkl from scripts/train_ranker.py
MATCH_MODEL=
# app deep link after GitHub connect, default formalconnect://connect/github
APP_GITHUB_REDIRECT=
# ML service only. Optional: only if the Expo project enforces push security
EXPO_ACCESS_TOKEN=
# ML service. Torch device for the embedder; defaults to cpu. Leave empty unless you know why:
# on an M-series Mac the auto-picked `mps` backend aborts the process with a Metal assertion.
EMBED_DEVICE=
# ML service. 1 (default) = rewrite the why-you-matched sentences with Haiku for variety, one
# batched call per graph request, cached in process. 0 = deterministic templates only (no API key
# needed). The factor bars are never affected either way.
EXPLAIN_VARY=
ASSISTANT_EFFORT=
